# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# On Google Colab, set these via the Secrets panel (key icon) instead.

# ── ArangoDB (benchmark corpus + graph — all arms) ────────────────────────────
# Local (default): use the bundled docker-compose — `docker compose up -d`,
#   then ARANGO_HOST=http://localhost:8529 and ARANGO_PASS=devpassword.
# Cloud (ArangoDB Oasis): point ARANGO_HOST at your deployment endpoint, e.g.
#   https://<your-deployment>.arangodb.cloud:8529
ARANGO_HOST=http://localhost:8529
ARANGO_USER=root
ARANGO_PASS=
ARANGO_DB=pubmed_graph

# ── Neo4j AuraDB (hosted agent's demo graph ONLY -- see scripts/ingest_neo4j.py) ─
# Not used by the benchmarked ablation above (that's ArangoDB). This is a
# separate, smaller graph (the PubMedQA labeled split only, ~1,000 papers)
# that backs graphrag.answer()'s graph_id="demo" path.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Ollama (LLM) ──────────────────────────────────────────────────────────────
OLLAMA_API=http://localhost:11434/api/chat
LLM_MODEL=deepseek-r1:8b
# LLM_NUM_CTX=4096        # config default; the published run used 8192 (make benchmark exports it)
# LLM_NUM_PREDICT=1024    # generation cap -- keep it bounded (see src/kgqa/config.py)
# LLM_TIMEOUT=180
# LLM_KEEP_ALIVE=30m

# ── Benchmark sampling ────────────────────────────────────────────────────────
# Changing either breaks comparability with the published numbers.
# BENCHMARK_N=200
# RANDOM_SEED=42

# ── Hosted agent LLM (kgqa.service / providers.py) ────────────────────────────
# Gemini Flash for the hosted agent; unset key falls through to Ollama above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Provider chain for the only task (synthesize), comma-separated, first success wins.
LLM_CHAIN_SYNTHESIZE=gemini,ollama

# ── Hosted agent runtime (see render.yaml / backend/README.md) ────────────────
# KGQA_ENCODER=onnx                     # torch-free encoder (fits 512MB)
# KGQA_SKIP_RERANKER=true               # no cross-encoder (= graph_norr config)
# KGQA_DISABLE_DATASET_FALLBACK=true    # fail fast (502) if the graph DB is down
# KGQA_WARM_ON_STARTUP=true             # load the demo store at startup
# KGQA_CACHE_DIR=
# CORS_ORIGINS=http://localhost:3000
